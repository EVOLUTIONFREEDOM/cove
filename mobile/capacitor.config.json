{
  "appId": "com.cove.trade",
  "appName": "Alpaca Cove",
  "webDir": "www",
  "backgroundColor": "#000000",
  "server": {
    "url": "https://supporters-rejected-ricky-leader.trycloudflare.com",
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "supporters-rejected-ricky-leader.trycloudflare.com",
      "*.trycloudflare.com",
      "*.fly.dev",
      "*.onrender.com",
      "evolutionfreedomltd.co.uk",
      "*.evolutionfreedomltd.co.uk"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#000000",
      "overlaysWebView": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#000000"
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "scheme": "Cove"
  }
}
